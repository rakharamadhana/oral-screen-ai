# Oral Screen AI — environment variables
#
# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API). Only VITE_-prefixed vars are exposed to the client.
# The anon/publishable key is safe to ship client-side; access is guarded by RLS.
#
# If these are left empty, the app transparently falls back to browser
# localStorage for scan history + profile, so it still runs without Supabase.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legal documents linked from the first-run consent gate on "Pemeriksaan Saya".
# If left empty the links fall back to "#" (no-op).
VITE_TERMS_URL=
VITE_PRIVACY_URL=
